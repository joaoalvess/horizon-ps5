set(git git -c safe.directory=* -C "${ROOT}")
execute_process(COMMAND ${git} rev-parse --short=10 HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE commit_status)
if(NOT commit_status EQUAL 0)
    set(identity "port=unknown")
else()
    execute_process(COMMAND ${git} status --porcelain OUTPUT_VARIABLE status ERROR_QUIET)
    string(REGEX MATCHALL "[^\n]+" changed "${status}")
    list(LENGTH changed changed_count)
    if(changed_count EQUAL 0)
        set(identity "port=${commit}")
    else()
        execute_process(COMMAND ${git} diff HEAD OUTPUT_VARIABLE diff ERROR_QUIET)
        string(SHA1 digest "${status}${diff}")
        string(SUBSTRING "${digest}" 0 10 digest)
        set(identity "port=${commit}+${changed_count}-changed-${digest}")
    endif()
endif()
set(content "#pragma once\n#define EDEN_BUILD_IDENTITY \"${identity}\"\n")
set(previous "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
